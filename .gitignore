# Rebuildable dependencies and generated files
**/node_modules/
**/vendor/
**/dist/
**/.turbo/
**/.cache/
**/.vite/
**/coverage/
**/*.tsbuildinfo
**/__pycache__/
**/*.pyc

# Machine-local configuration and runtime data
**/.env
**/.env.local
**/.env.*.local
backend/runtime/
backend/storage/
backend/public/uploads/
**/*.log
**/*.pem
**/*.key
**/*.pfx
**/*.p12
.idea/
.vscode/
.DS_Store
Thumbs.db

# The admin app's Vite metadata is public build configuration, not a secret.
!frontend/apps/web-admin/.env
